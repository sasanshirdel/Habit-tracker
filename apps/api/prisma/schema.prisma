// Prisma schema (database foundation P1-01; identity tables P2-01).
//
// Models are added per roadmap phase with version-controlled migrations
// (`pnpm --filter @habit/api db:migrate:dev --name <change>`).
// See docs/ARCHITECTURE.md §Data, ADR-0006 (data conventions) and the conceptual entity list in
// docs/PRODUCT_REQUIREMENTS.md §6.
//
// The connection URL is NOT configured here: Prisma 7 reads it from prisma.config.ts (CLI) and the
// API passes it to the pg driver adapter at runtime (src/database/prisma.service.ts).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Pinned explicitly so the generated client matches the API's ESM/NodeNext setup.
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
// Identity (backlog P2-01, ADR-0005, ADR-0017). Owned by the `identity` feature module
// (src/modules/identity); no other module reads or writes these tables directly.
//
// Conventions (ADR-0006): UUIDv7 ids generated by the Prisma client in the app, snake_case table
// and column names, every instant `timestamptz` (UTC). Database CHECK constraints that Prisma
// cannot express live in the migration SQL (see the migration and ADR-0017):
//   - users.email: 3..254 characters, no surrounding whitespace, contains "@"
//   - user_password_credentials.password_hash: an Argon2id PHC string ("$argon2id$v=19$...")
//   - user_sessions/user_tokens.token_hash: exactly 32 bytes (SHA-256 of the opaque token)
//   - expires_at after created_at; revoked_at and revoked_reason set together
//   - email-verification tokens carry the address they verify
// No secret is stored in clear: sessions and tokens keep only a SHA-256 hash of a 256-bit random
// value, passwords only an Argon2id hash (hashing itself arrives with P2-02).
// ─────────────────────────────────────────────────────────────────────────────────────────────────

/// UI language a user chose. Mirrors the web app's locales (@habit/localization).
enum Locale {
  en
  fa

  @@map("locale")
}

/// Colour theme a user chose (ADR-0013: dark is the product default).
enum ThemePreference {
  dark
  light
  system

  @@map("theme_preference")
}

/// What a single-use emailed token may be used for.
enum UserTokenPurpose {
  email_verification
  password_reset

  @@map("user_token_purpose")
}

/// Why a session ended before it expired (shown in session management, P2-08).
enum SessionRevocationReason {
  sign_out
  sign_out_everywhere
  rotated
  password_changed
  account_deleted
  /// Ended from another session's device list (P2-08): one session, or "all other devices".
  revoked_by_user

  @@map("session_revocation_reason")
}

/// Coarse browser family derived from the User-Agent at sign-in (P2-08, ADR-0023). Never the raw
/// header or a version.
enum ClientBrowser {
  chrome
  edge
  firefox
  safari
  opera
  samsung_internet
  unknown

  @@map("client_browser")
}

/// Coarse operating-system family (P2-08, ADR-0023).
enum ClientOs {
  windows
  macos
  ios
  android
  linux
  chromeos
  unknown

  @@map("client_os")
}

/// Coarse device class (P2-08, ADR-0023).
enum ClientDevice {
  desktop
  mobile
  tablet
  unknown

  @@map("client_device")
}

/// What a security event records (P2-08, ADR-0023).
enum SecurityEventType {
  sign_in
  sign_out
  signed_out_everywhere
  signed_out_other_sessions
  session_revoked
  password_reset
  email_verified

  @@map("security_event_type")
}

/// A customer account (ADR-0005: never an administrator; staff use a separate identity table).
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Unique case-insensitively (citext), including soft-deleted accounts.
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete: set when the user deletes the account; hard deletion follows the retention
  /// policy (P2-10). Rows with deletedAt set must be treated as non-existent by every query.
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  profile            UserProfile?
  preference         UserPreference?
  passwordCredential UserPasswordCredential?
  sessions           UserSession[]
  tokens             UserToken[]
  securityEvents     UserSecurityEvent[]

  @@map("users")
}

/// Public-facing profile details (avatar arrives with P2-07).
model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  /// 1..100 characters when set.
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Per-user settings that change how the product is presented.
model UserPreference {
  userId    String          @id @map("user_id") @db.Uuid
  /// No default: set from the language the user registered in.
  locale    Locale
  /// IANA time zone name (validated by the application; 1..64 characters).
  timezone  String
  theme     ThemePreference @default(dark)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// Email/password credential. Kept apart from User so accounts may exist without a password
/// (Google sign-in, P2-06).
model UserPasswordCredential {
  userId       String   @id @map("user_id") @db.Uuid
  /// Argon2id PHC string only — never a plaintext or reversible value.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_password_credentials")
}

/// A browser session (ADR-0005). The cookie carries an opaque random token; only its SHA-256
/// hash is stored, so a database leak does not yield usable sessions.
model UserSession {
  id            String                   @id @default(uuid(7)) @db.Uuid
  userId        String                   @map("user_id") @db.Uuid
  tokenHash     Bytes                    @unique @map("token_hash") @db.ByteA
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime                 @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Absolute expiry; idle timeout is enforced from lastUsedAt by the application.
  expiresAt     DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason SessionRevocationReason? @map("revoked_reason")
  /// Coarse client description from the User-Agent at sign-in (P2-08, ADR-0023). No raw user
  /// agent and no IP address are stored.
  clientBrowser ClientBrowser            @default(unknown) @map("client_browser")
  clientOs      ClientOs                 @default(unknown) @map("client_os")
  clientDevice  ClientDevice             @default(unknown) @map("client_device")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// A security-relevant event of a customer account, shown to the user (P2-08, ADR-0023). Written in
/// the same transaction as the change it records; kept for the retention window only. Holds no IP
/// address, user agent, email or token.
model UserSecurityEvent {
  id            String            @id @default(uuid(7)) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  type          SecurityEventType
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  clientBrowser ClientBrowser     @default(unknown) @map("client_browser")
  clientOs      ClientOs          @default(unknown) @map("client_os")
  clientDevice  ClientDevice      @default(unknown) @map("client_device")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("user_security_events")
}

/// Single-use emailed token for email verification (P2-04) or password reset (P2-05). Only the
/// SHA-256 hash of the token is stored.
model UserToken {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    UserTokenPurpose
  tokenHash  Bytes            @unique @map("token_hash") @db.ByteA
  /// The address an email-verification token confirms (required for that purpose), so changing
  /// the email invalidates outstanding verification links.
  email      String?          @db.Citext
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("user_tokens")
}
