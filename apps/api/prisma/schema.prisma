// Prisma schema (database foundation P1-01; identity tables P2-01; habit tables P3-01).
//
// Models are added per roadmap phase with version-controlled migrations
// (`pnpm --filter @habit/api db:migrate:dev --name <change>`).
// See docs/ARCHITECTURE.md §Data, ADR-0006 (data conventions) and the conceptual entity list in
// docs/PRODUCT_REQUIREMENTS.md §6.
//
// The connection URL is NOT configured here: Prisma 7 reads it from prisma.config.ts (CLI) and the
// API passes it to the pg driver adapter at runtime (src/database/prisma.service.ts).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Pinned explicitly so the generated client matches the API's ESM/NodeNext setup.
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
// Identity (backlog P2-01, ADR-0005, ADR-0017). Owned by the `identity` feature module
// (src/modules/identity); no other module reads or writes these tables directly.
//
// Conventions (ADR-0006): UUIDv7 ids generated by the Prisma client in the app, snake_case table
// and column names, every instant `timestamptz` (UTC). Database CHECK constraints that Prisma
// cannot express live in the migration SQL (see the migration and ADR-0017):
//   - users.email: 3..254 characters, no surrounding whitespace, contains "@"
//   - user_password_credentials.password_hash: an Argon2id PHC string ("$argon2id$v=19$...")
//   - user_sessions/user_tokens.token_hash: exactly 32 bytes (SHA-256 of the opaque token)
//   - expires_at after created_at; revoked_at and revoked_reason set together
//   - email-verification tokens carry the address they verify
// No secret is stored in clear: sessions and tokens keep only a SHA-256 hash of a 256-bit random
// value, passwords only an Argon2id hash (hashing itself arrives with P2-02).
// ─────────────────────────────────────────────────────────────────────────────────────────────────

/// UI language a user chose. Mirrors the web app's locales (@habit/localization).
enum Locale {
  en
  fa

  @@map("locale")
}

/// Colour theme a user chose (ADR-0013: dark is the product default).
enum ThemePreference {
  dark
  light
  system

  @@map("theme_preference")
}

/// Calendar dates are shown in (P2-07, ADR-0024). Display only: storage stays UTC / ISO dates.
enum CalendarSystem {
  gregorian
  solar_hijri

  @@map("calendar_system")
}

/// First day of the week in weekly views (P2-07, ADR-0024).
enum WeekStart {
  saturday
  sunday
  monday

  @@map("week_start")
}

/// What a single-use emailed token may be used for.
enum UserTokenPurpose {
  email_verification
  password_reset
  /// Restores a deleted account during the grace period (P2-10, ADR-0025).
  account_restore

  @@map("user_token_purpose")
}

/// Why a session ended before it expired (shown in session management, P2-08).
enum SessionRevocationReason {
  sign_out
  sign_out_everywhere
  rotated
  password_changed
  account_deleted
  /// Ended from another session's device list (P2-08): one session, or "all other devices".
  revoked_by_user

  @@map("session_revocation_reason")
}

/// Coarse browser family derived from the User-Agent at sign-in (P2-08, ADR-0023). Never the raw
/// header or a version.
enum ClientBrowser {
  chrome
  edge
  firefox
  safari
  opera
  samsung_internet
  unknown

  @@map("client_browser")
}

/// Coarse operating-system family (P2-08, ADR-0023).
enum ClientOs {
  windows
  macos
  ios
  android
  linux
  chromeos
  unknown

  @@map("client_os")
}

/// Coarse device class (P2-08, ADR-0023).
enum ClientDevice {
  desktop
  mobile
  tablet
  unknown

  @@map("client_device")
}

/// What a security event records (P2-08, ADR-0023).
enum SecurityEventType {
  sign_in
  sign_out
  signed_out_everywhere
  signed_out_other_sessions
  session_revoked
  password_reset
  email_verified
  /// A copy of the account's data was downloaded (P2-10, ADR-0025).
  data_exported
  /// The account was deleted — soft delete, restorable during the grace period (P2-10).
  account_deletion_requested
  /// A deleted account was restored with the emailed link (P2-10).
  account_restored

  @@map("security_event_type")
}

/// A customer account (ADR-0005: never an administrator; staff use a separate identity table).
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Unique case-insensitively (citext), including soft-deleted accounts.
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete (P2-10, ADR-0025): set when the user deletes the account. Rows with deletedAt set
  /// must be treated as non-existent by every query except restore and purge; the purge job erases
  /// the row (and, by cascade, everything owned by the user) once the grace period has passed.
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  profile              UserProfile?
  preference           UserPreference?
  passwordCredential   UserPasswordCredential?
  sessions             UserSession[]
  tokens               UserToken[]
  securityEvents       UserSecurityEvent[]
  habitCategories      HabitCategory[]
  habits               Habit[]
  habitSchedules       HabitScheduleVersion[]
  habitScheduleChanges HabitScheduleChange[]
  habitOccurrences     HabitOccurrence[]
  habitCheckIns        HabitCheckIn[]
  habitNotes           HabitNote[]
  habitPauses          HabitPause[]

  /// The purge job finds accounts whose grace period has passed (P2-10).
  @@index([deletedAt])
  @@map("users")
}

/// Public-facing profile details, edited at `PATCH /account/profile` (P2-07). Avatar upload is a
/// follow-up of P2-07 that waits for the object-storage decision (ROADMAP "Outstanding decisions" #3).
model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  /// 1..100 characters when set.
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Per-user settings that change how the product is presented.
model UserPreference {
  userId    String          @id @map("user_id") @db.Uuid
  /// No default: set from the language the user registered in.
  locale    Locale
  /// IANA time zone name (validated by the application; 1..64 characters).
  timezone  String
  theme     ThemePreference @default(dark)
  /// Set from the registration locale (fa → solar_hijri, en → gregorian); the default only
  /// covers rows written before P2-07, which the migration backfilled the same way.
  calendar  CalendarSystem  @default(gregorian)
  /// Set from the registration locale (fa → saturday, en → monday), like `calendar`.
  weekStart WeekStart       @default(monday) @map("week_start")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// Email/password credential. Kept apart from User so accounts may exist without a password
/// (Google sign-in, P2-06).
model UserPasswordCredential {
  userId       String   @id @map("user_id") @db.Uuid
  /// Argon2id PHC string only — never a plaintext or reversible value.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_password_credentials")
}

/// A browser session (ADR-0005). The cookie carries an opaque random token; only its SHA-256
/// hash is stored, so a database leak does not yield usable sessions.
model UserSession {
  id            String                   @id @default(uuid(7)) @db.Uuid
  userId        String                   @map("user_id") @db.Uuid
  tokenHash     Bytes                    @unique @map("token_hash") @db.ByteA
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime                 @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Absolute expiry; idle timeout is enforced from lastUsedAt by the application.
  expiresAt     DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason SessionRevocationReason? @map("revoked_reason")
  /// Coarse client description from the User-Agent at sign-in (P2-08, ADR-0023). No raw user
  /// agent and no IP address are stored.
  clientBrowser ClientBrowser            @default(unknown) @map("client_browser")
  clientOs      ClientOs                 @default(unknown) @map("client_os")
  clientDevice  ClientDevice             @default(unknown) @map("client_device")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  /// For the daily retention clean-up of ended sessions (ADR-0026): revoked, expired or idle.
  @@index([revokedAt])
  @@index([lastUsedAt])
  @@map("user_sessions")
}

/// A security-relevant event of a customer account, shown to the user (P2-08, ADR-0023). Written in
/// the same transaction as the change it records; kept for the retention window only. Holds no IP
/// address, user agent, email or token.
model UserSecurityEvent {
  id            String            @id @default(uuid(7)) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  type          SecurityEventType
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  clientBrowser ClientBrowser     @default(unknown) @map("client_browser")
  clientOs      ClientOs          @default(unknown) @map("client_os")
  clientDevice  ClientDevice      @default(unknown) @map("client_device")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("user_security_events")
}

/// Single-use emailed token for email verification (P2-04) or password reset (P2-05). Only the
/// SHA-256 hash of the token is stored.
model UserToken {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    UserTokenPurpose
  tokenHash  Bytes            @unique @map("token_hash") @db.ByteA
  /// The address an email-verification token confirms (required for that purpose), so changing
  /// the email invalidates outstanding verification links.
  email      String?          @db.Citext
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("user_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
// Habits (backlog P3-01, ADR-0028). Owned by the `habits` feature module (src/modules/habits); no
// other module reads or writes these tables directly.
//
// Every row carries `user_id` (owner scoping, ON DELETE CASCADE from users for the account purge),
// and children reference their habit through composite keys that include `user_id`, so a row can
// never point at another user's habit or category. Schedule versions and occurrences also repeat
// the habit's `type` in their key, which makes the type immutable once a habit has rows and lets
// the database check type-specific values. Calendar days are `date` columns holding the user's
// local date (ISO/Gregorian; Solar Hijri is display only, ADR-0024); instants are timestamptz.
// Hand-written in the migration SQL (Prisma cannot express them), kept in step with
// `HABIT_LIMITS` in @habit/shared-validation by a unit test:
//   - text lengths, palette/icon token shapes, date window, value and target bounds;
//   - one schedule shape per `kind`, type-specific target and value rules;
//   - schedule versions of a habit never overlap (EXCLUDE … USING gist, extension btree_gist).
// Occurrences are NOT generated rows: a row exists only where the user recorded something for a
// day; Due/Missed/Paused/Not scheduled are computed from the schedule (P3-02, P3-04).
// ─────────────────────────────────────────────────────────────────────────────────────────────────

/// The six habit types of PRD §3.1. Fixed for the life of a habit (ADR-0028).
enum HabitType {
  /// Done or not done on a scheduled day (recorded value 1 or 0).
  binary
  /// An amount per day towards an at-least target (e.g. 8 glasses).
  numeric
  /// Seconds per day towards an at-least target (e.g. 20 minutes of meditation).
  duration
  /// Done on some days, counted against "N times per week/month" (schedule kind times_per_period).
  frequency
  /// Avoiding a behaviour: lapses per day, at most the target (usually 0).
  negative
  /// A user-defined measure with its own unit and direction (at least / at most).
  custom

  @@map("habit_type")
}

/// How a schedule version picks the days a habit is due (P3-02 computes the days).
enum HabitScheduleKind {
  /// Every day.
  daily
  /// The ISO weekdays in `days_of_week` (1 = Monday … 7 = Sunday).
  weekdays
  /// The days in `days_of_month` (1…31; -1 = last day of the month).
  monthly_days
  /// Every `interval_days` days counted from `anchor_date`.
  interval
  /// Any days, `times_per_period` times per `period` (flexible / weekly frequency targets).
  times_per_period

  @@map("habit_schedule_kind")
}

/// Period of a times-per-period schedule.
enum HabitSchedulePeriod {
  week
  month

  @@map("habit_schedule_period")
}

/// Direction of a target: reach at least / stay at or below the target value.
enum HabitTargetComparison {
  at_least
  at_most

  @@map("habit_target_comparison")
}

/// A user's own habit category (name unique per user, case-insensitively).
model HabitCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// 1..50 characters, NFKC-normalised by the application.
  name      String   @db.Citext
  /// Palette token (design tokens, never a raw colour), e.g. "teal".
  color     String?
  /// Icon token, e.g. "dumbbell".
  icon      String?
  /// Display order among the user's categories (ascending; ties by id).
  position  Int      @default(0)
  /// Optimistic-concurrency version for offline edits (ADR-0006).
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits Habit[]

  @@unique([userId, name])
  /// Target of the habits' composite (category, owner) foreign key.
  @@unique([id, userId])
  @@map("habit_categories")
}

/// A habit. Its rules over time live in `habit_schedule_versions`; its recorded days in
/// `habit_occurrences`.
model Habit {
  id                   String    @id @default(uuid(7)) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  /// Must be one of the owner's categories (composite key); null = uncategorised.
  categoryId           String?   @map("category_id") @db.Uuid
  type                 HabitType
  /// 1..100 characters.
  name                 String
  /// Up to 2000 characters.
  description          String?
  /// Unit label for numeric, negative and custom habits (e.g. "pages"); null for the others.
  unit                 String?
  icon                 String?
  color                String?
  /// First local date the habit applies (inclusive).
  startsOn             DateTime  @map("starts_on") @db.Date
  /// Last local date the habit applies (inclusive); null = open-ended.
  endsOn               DateTime? @map("ends_on") @db.Date
  /// Preferred time of day in minutes after local midnight (0..1439); null = any time.
  preferredTimeMinutes Int?      @map("preferred_time_minutes") @db.SmallInt
  /// Display order among the user's habits (ascending; ties by id).
  position             Int       @default(0)
  /// Optimistic-concurrency version for offline edits (ADR-0006).
  version              Int       @default(1)
  /// Archived habits keep their history but leave active views (restorable).
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(3)
  /// Soft delete (restorable until a retention purge, P3-06); hidden everywhere but export.
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         HabitCategory?         @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  scheduleVersions HabitScheduleVersion[]
  occurrences      HabitOccurrence[]
  checkIns         HabitCheckIn[]
  notes            HabitNote[]
  pauses           HabitPause[]
  scheduleChanges  HabitScheduleChange[]

  /// Targets of the children's composite foreign keys (owner, and owner + type).
  @@unique([id, userId])
  @@unique([id, userId, type])
  @@index([userId, position])
  @@index([categoryId, userId])
  @@index([deletedAt])
  @@map("habits")
}

/// One version of a habit's rules: when it is due and what counts as done, valid for the local
/// dates [effective_from, effective_to). Versions of a habit never overlap; at most one is open
/// (effective_to null). Editing a schedule closes the current version and opens a new one (P3-03),
/// so past days keep the rules that applied to them.
model HabitScheduleVersion {
  id               String                 @id @default(uuid(7)) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  habitId          String                 @map("habit_id") @db.Uuid
  /// Copy of habits.type (part of the foreign key; never differs).
  habitType        HabitType              @map("habit_type")
  effectiveFrom    DateTime               @map("effective_from") @db.Date
  /// Exclusive end; null = still in effect.
  effectiveTo      DateTime?              @map("effective_to") @db.Date
  kind             HabitScheduleKind
  /// ISO weekdays (1 = Monday … 7 = Sunday) for kind `weekdays`; empty otherwise.
  daysOfWeek       Int[]                  @default([]) @map("days_of_week") @db.SmallInt
  /// Days of the month (1..31, -1 = last day) for kind `monthly_days`; empty otherwise.
  daysOfMonth      Int[]                  @default([]) @map("days_of_month") @db.SmallInt
  /// Every N days (2..365) for kind `interval`, counted from `anchorDate`.
  intervalDays     Int?                   @map("interval_days") @db.SmallInt
  anchorDate       DateTime?              @map("anchor_date") @db.Date
  /// For kind `times_per_period`: N times per week (1..7) or per month (1..31).
  period           HabitSchedulePeriod?
  timesPerPeriod   Int?                   @map("times_per_period") @db.SmallInt
  /// Grace allowance for streaks (0..7); exact semantics are P3-05's.
  graceDays        Int                    @default(0) @map("grace_days") @db.SmallInt
  /// Daily target for numeric, duration (seconds), negative and custom habits; null otherwise.
  targetValue      Decimal?               @map("target_value") @db.Decimal(12, 3)
  targetComparison HabitTargetComparison? @map("target_comparison")
  /// The user's week start when this version was written (P3-03, ADR-0030): weekly periods of
  /// this version are counted from it, so a later preference change never re-buckets history.
  weekStart        WeekStart              @map("week_start")
  /// The user's calendar when this version was written (P3-03, ADR-0030): months of this
  /// version (monthly days, times per month) are Gregorian or Solar Hijri months.
  calendar         CalendarSystem
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit   Habit                 @relation(fields: [habitId, userId, habitType], references: [id, userId, type], onDelete: Cascade, onUpdate: NoAction)
  changes HabitScheduleChange[]

  @@unique([habitId, effectiveFrom])
  /// Target of habit_schedule_changes' composite key (a change names a version of its own habit).
  @@unique([id, habitId])
  @@index([userId])
  @@map("habit_schedule_versions")
}

/// What a schedule change did (P3-03, ADR-0030).
enum HabitScheduleOperation {
  /// The habit's first version (written with the habit).
  create
  /// The version in effect on the effective date was closed the day before and a new one opened.
  split
  /// A version starting on the effective date had its rules replaced in place.
  replace

  @@map("habit_schedule_operation")
}

/// Append-only audit trail of schedule changes (P3-03, ADR-0030): who changed which habit's rules,
/// from which local date, what the versions looked like before and after, and whether the change
/// reached back before the user's "today" (a historical correction, which needs a reason).
/// Written in the same transaction as the change; never updated.
model HabitScheduleChange {
  id                   String                 @id @default(uuid(7)) @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  habitId              String                 @map("habit_id") @db.Uuid
  /// The version created (create, split) or rewritten (replace).
  versionId            String                 @map("version_id") @db.Uuid
  operation            HabitScheduleOperation
  /// First local date the change applies to.
  effectiveFrom        DateTime               @map("effective_from") @db.Date
  /// The user's local date when the change was made (in their profile time zone).
  localToday           DateTime               @map("local_today") @db.Date
  /// True when `effective_from` is before `local_today`: past days are judged by new rules.
  isCorrection         Boolean                @map("is_correction")
  /// Why (required for corrections; 1..500 characters).
  reason               String?
  /// Recorded days (habit_occurrences) on dates the change re-judged (before `local_today`).
  affectedRecordedDays Int                    @default(0) @map("affected_recorded_days")
  /// The affected versions as they were (null for create).
  before               Json?
  /// The affected versions as written.
  after                Json
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit   Habit                @relation(fields: [habitId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)
  version HabitScheduleVersion @relation(fields: [versionId, habitId], references: [id, habitId], onDelete: Cascade, onUpdate: NoAction)

  @@index([habitId, createdAt])
  @@index([userId])
  @@index([versionId, habitId])
  @@map("habit_schedule_changes")
}

/// What the user recorded for one habit on one local date: a value or a skip. At most one row per
/// habit and day. Statuses (Completed, Missed, Due, Skipped, Paused, Not scheduled) are derived
/// from this row, the schedule version in effect that day and pauses (P3-04) — never stored.
model HabitOccurrence {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  habitId   String    @map("habit_id") @db.Uuid
  /// Copy of habits.type (part of the foreign key; never differs).
  habitType HabitType @map("habit_type")
  /// The user's local calendar date this entry belongs to.
  localDate DateTime  @map("local_date") @db.Date
  /// The day's amount: 1/0 for binary and frequency, seconds for duration, the measured amount
  /// for numeric and custom, lapses for negative. Null exactly when skipped.
  value     Decimal?  @db.Decimal(12, 3)
  /// The user excused this day (counts neither as done nor as missed).
  skipped   Boolean   @default(false)
  /// Optimistic-concurrency version for offline edits (ADR-0006).
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId, userId, habitType], references: [id, userId, type], onDelete: Cascade, onUpdate: NoAction)

  @@unique([habitId, localDate])
  @@index([userId, localDate])
  @@map("habit_occurrences")
}

/// What a check-in did to a day (P3-04, ADR-0031).
enum HabitCheckInAction {
  /// Recorded a value.
  set
  /// Excused the day.
  skip
  /// Removed the day's record.
  clear

  @@map("habit_check_in_action")
}

/// Append-only log of accepted check-in operations (P3-04, ADR-0031; PRD §6 "HabitCompletion").
/// The client generates `operation_id` once per user action and sends it with every retry: a
/// repeated operation id is answered from this log instead of being applied again (idempotency,
/// PRD §8). The day's current value is `habit_occurrences`; this table is its history. Written in
/// the same transaction as the record; never updated.
model HabitCheckIn {
  id                String             @id @default(uuid(7)) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  habitId           String             @map("habit_id") @db.Uuid
  /// Copy of habits.type (part of the foreign key, so the value CHECK can follow the type).
  habitType         HabitType          @map("habit_type")
  /// Client-generated operation id (UUID); unique per user.
  operationId       String             @map("operation_id") @db.Uuid
  /// The user's local calendar date the operation is about.
  localDate         DateTime           @map("local_date") @db.Date
  action            HabitCheckInAction
  /// The recorded value (set only).
  value             Decimal?           @db.Decimal(12, 3)
  /// Whether the stored record changed (a repeat of the same value does not).
  changed           Boolean
  /// habit_occurrences.version after the operation; null when no record remains.
  occurrenceVersion Int?               @map("occurrence_version")
  /// The user's local date when the operation was accepted (profile time zone).
  localToday        DateTime           @map("local_today") @db.Date
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId, userId, habitType], references: [id, userId, type], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, operationId])
  @@index([habitId, localDate])
  @@map("habit_check_ins")
}

/// A note on a habit, optionally about one local date (habit detail page, PRD §3.1).
model HabitNote {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  habitId   String    @map("habit_id") @db.Uuid
  localDate DateTime? @map("local_date") @db.Date
  /// 1..5000 characters.
  body      String
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([habitId, createdAt])
  @@index([userId])
  @@map("habit_notes")
}

/// A pause of one habit, or a vacation of all the user's habits (habit_id null), over the local
/// dates [starts_on, ends_on] (inclusive; ends_on null = until resumed). Paused days are neither
/// due nor missed (P3-02, P3-05).
model HabitPause {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  habitId   String?   @map("habit_id") @db.Uuid
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit? @relation(fields: [habitId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, startsOn])
  @@index([habitId])
  @@map("habit_pauses")
}
