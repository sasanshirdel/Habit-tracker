{
  "name": "habit-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Bilingual (Persian RTL / English LTR) personal productivity & performance platform \u2014 monorepo root.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter \"./packages/**\" --if-present run build",
    "build:deps": "pnpm build:packages && pnpm --filter @habit/api build",
    "lint": "pnpm -r --if-present run lint && pnpm check:architecture",
    "check:architecture": "node packages/config/architecture/cli.js",
    "typecheck": "pnpm build:deps && pnpm -r --if-present run typecheck",
    "test": "pnpm build:deps && pnpm -r --if-present run test",
    "test:integration": "pnpm build:deps && pnpm -r --if-present run test:integration",
    "build": "pnpm -r --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:services": "docker compose up -d postgres redis",
    "dev:services:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
