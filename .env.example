# Copy to `.env` for local development. Placeholder values only — never commit real secrets.
# Production/staging secrets live in the deployment secret manager / GitHub Actions secrets.

# --- Runtime ---
NODE_ENV=development

# --- API (apps/api) ---
API_PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Rate limiting (P1-08, ADR-0011): counters in Redis under RATE_LIMIT_PREFIX. Disable only for local
# load tests. TRUST_PROXY = number of reverse proxies in front of the API whose X-Forwarded-For is
# trusted for the client address (0 = none; set the exact hop count behind a load balancer).
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREFIX=habit:rl
TRUST_PROXY=0
# OpenAPI document at /api/docs/openapi.json (P1-06, ADR-0012). Unset: served unless
# NODE_ENV=production. Production/staging serve it only with an explicit true (logged as a warning).
# API_DOCS_ENABLED=true

# Local docker-compose Postgres (dev-only credentials; change for anything non-local).
# DATABASE_URL is required by the API (it refuses to boot without it) and by Prisma migrate.
POSTGRES_USER=habit
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=habit_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://habit:change-me-local-only@localhost:5432/habit_dev?schema=public

# Local docker-compose Redis. Required by the API and the worker (queues, P1-03) and by
# `pnpm test:integration` (keys under habit:it:<run>:). Use rediss:// for TLS.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Namespace for all BullMQ keys (<prefix>:<queue>:...).
QUEUE_PREFIX=habit:q

# --- Logging (api + worker, P1-07) ---
# Lowest level written: trace | debug | info | warn | error | fatal (default: debug in development,
# info otherwise). Format: json (default, one object per line) or pretty (local reading only).
# LOG_LEVEL=debug
# LOG_FORMAT=pretty

# --- Worker (apps/worker) --- also uses NODE_ENV, DATABASE_URL, REDIS_URL, QUEUE_PREFIX
# Jobs processed in parallel per queue.
WORKER_CONCURRENCY=5
# Graceful shutdown: wait this long for in-flight jobs before disconnecting (keep below the
# orchestrator's termination grace period).
WORKER_SHUTDOWN_TIMEOUT_MS=25000
# Transactional email (P2-04, ADR-0021) — sent by the worker. Development/test transports only:
# `log` (default; nothing delivered, one redacted log line) or `outbox` (each email written as a
# JSON file to MAIL_OUTBOX_DIR, so you can open the verification link). No real provider yet.
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=.mail-outbox
# Sender of every email (placeholder until the product domain is decided).
MAIL_FROM=Habit Tracker <no-reply@localhost>
# Origin the emailed links point to (the web app). https, except http on localhost/127.0.0.1.
WEB_APP_URL=http://localhost:3000

# --- Web (apps/web) ---
# Public (browser-exposed) values only. Never put secrets in NEXT_PUBLIC_* variables.
# The API as the browser reaches it (also the CSP connect-src). Unset: `/api/v1` on the web origin,
# which only works behind a reverse proxy routing /api to the API (ADR-0014).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
