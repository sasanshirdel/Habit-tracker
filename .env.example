# Copy to `.env` for local development. Placeholder values only — never commit real secrets.
# Production/staging secrets live in the deployment secret manager / GitHub Actions secrets.

# --- Runtime ---
NODE_ENV=development

# --- API (apps/api) ---
API_PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Local docker-compose Postgres (dev-only credentials; change for anything non-local).
# DATABASE_URL is required by the API (it refuses to boot without it) and by Prisma migrate.
POSTGRES_USER=habit
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=habit_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://habit:change-me-local-only@localhost:5432/habit_dev?schema=public

# Local docker-compose Redis.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Web (apps/web) ---
# Public (browser-exposed) values only. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
